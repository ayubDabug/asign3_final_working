{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",   
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/user/(.*)",  
            "dest": "/api/index.js/$1" 
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.js" 
        }
    ]
}
